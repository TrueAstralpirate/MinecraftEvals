# Copy to .env (which is gitignored) to set local defaults.

# Default model for `inspect eval` (a --model flag still overrides it).
# claudecode/... runs Claude through the `claude` CLI on your subscription.
INSPECT_EVAL_MODEL=claudecode/sonnet

# Only needed for API providers, e.g. --model anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=
